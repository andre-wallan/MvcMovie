@model IEnumerable<MvcMovie.Models.Movie>

@{
    ViewData["Title"] = "My Movies";
    var years = ViewData["Years"] as IEnumerable<int> ?? Enumerable.Empty<int>();
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentYear = ViewData["CurrentYear"] as int?;
}

<h1>My Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-controller="Movies" asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label for="searchString" class="form-label">Search</label>
        <input id="searchString" name="searchString" type="text" class="form-control" value="@currentFilter" placeholder="Title or genre" />
    </div>

    <div class="col-md-3">
        <label for="minYear" class="form-label">Released in or after</label>
        <select id="minYear" name="minYear" class="form-select">
            <option value="">All years</option>
            @foreach (var year in years)
            {
                <option value="@year" selected="@(currentYear == year ? "selected" : null)">@year</option>
            }
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>

    <div class="col-md-2 d-grid">
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Title)</th>
            <th>@Html.DisplayNameFor(model => model.First().ReleaseDate)</th>
            <th>@Html.DisplayNameFor(model => model.First().Genre)</th>
            <th>@Html.DisplayNameFor(model => model.First().Price)</th>
            <th>@Html.DisplayNameFor(model => model.First().Rating)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.ReleaseDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Genre)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.Rating)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
